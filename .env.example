# Bind address / port (localhost only; Tailscale Funnel is the public edge)
HOST=127.0.0.1
PORT=8787

# Allowlisted workspace root for all file/shell tools
WORKSPACE_ROOT=/home/chan/Documents/GitHub

# Bearer token required on every MCP request
# Prefer storing the token in ~/.config/browser-agent-mcp/token
MCP_AUTH_TOKEN=

# Comma-separated Host headers allowed (DNS rebinding protection)
# Include localhost plus your Tailscale Funnel MagicDNS name
ALLOWED_HOSTS=127.0.0.1,localhost,chan-hp-laptop-15s-eq2xxx.tail6b030d.ts.net

# Bash tool hard timeout in milliseconds (default 30000 for faster failures)
BASH_TIMEOUT_MS=30000
