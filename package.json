{
  "name": "browser-agent-mcp",
  "version": "1.0.0",
  "description": "OpenClaude-like coding tools over Streamable HTTP MCP for browser ChatGPT/Claude via Tailscale Funnel",
  "type": "module",
  "bin": {
    "browser-agent-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "npm --prefix ui run build",
    "build:server": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
